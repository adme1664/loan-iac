# Copy to .env and fill in the values.

# PostgreSQL
POSTGRES_VERSION=16
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=changeme
# Source database read by the Kafka Connect JDBC connectors (container hostname)
DB_HOST=postgres
DB_NAME=changeme
# Host port
POSTGRES_PORT=5432

# MongoDB
MONGO_VERSION=8.0
MONGO_USER=changeme
MONGO_PASSWORD=changeme
MONGO_DB=changeme
# Host port
MONGO_PORT=27017

# Kafka (KRaft)
KAFKA_VERSION=4.1.0
# Generate with: docker run --rm apache/kafka:4.1.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=changeme
# Host port for clients running outside Docker
KAFKA_PORT=9094

# Schema Registry (Confluent Platform 8.1.x = Kafka 4.1)
SCHEMA_REGISTRY_VERSION=8.1.6
# Host port (REST API)
SCHEMA_REGISTRY_PORT=8081

# Kafka Connect (Confluent Platform 8.1.x = Kafka 4.1)
KAFKA_CONNECT_VERSION=8.1.6
# Confluent Hub plugin versions
KAFKA_CONNECT_JDBC_VERSION=10.9.9
KAFKA_CONNECT_JSON_SCHEMA_VERSION=0.2.5
# Host port (REST API)
KAFKA_CONNECT_PORT=8083

# Kafka UI
KAFKA_UI_VERSION=v1.3.0
KAFKA_UI_PORT=8085

# Observability (Grafana + Loki for logs, Prometheus for metrics, Alloy as log collector)
PROMETHEUS_VERSION=v3.15.0
# Host port
PROMETHEUS_PORT=9090
LOKI_VERSION=3.7.8
# Host port (HTTP API)
LOKI_PORT=3100
ALLOY_VERSION=v1.20.1
GRAFANA_VERSION=13.2.3
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme
GRAFANA_PORT=3000

# Zipkin (distributed tracing)
ZIPKIN_VERSION=3.6.1
# Host port (UI and span collector)
ZIPKIN_PORT=9411

# Flink (stream processing)
FLINK_VERSION=2.2.1-scala_2.12-java17
# Must match the Flink minor version (suffix after the dash)
FLINK_KAFKA_CONNECTOR_VERSION=5.0.0-2.2
# Host port of the web UI (8081 is the Schema Registry)
FLINK_PORT=8088
