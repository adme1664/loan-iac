{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoanAgreement",
  "description": "Loan agreement document produced by commercialloan.loan_view (subject 3857.dev.loan.agreements.v1-loan_view-value).",
  "type": "object",
  "properties": {
    "agreementNo": { "type": "string" },
    "agreementType": { "type": "string" },
    "agreement": {
      "type": "object",
      "properties": {
        "agreementId": { "type": "string", "description": "UUID" },
        "agreementNo": { "type": "string" },
        "creditFacilityNo": { "type": "string" },
        "agreementType": { "type": "string" },
        "productCode": { "type": "string" },
        "statusCodeSoure": { "type": "string" },
        "statusCd": { "type": "string" },
        "unbnkLetterIssuerInd": { "type": "boolean" },
        "originalAmt": { "type": "number" },
        "effctvDt": { "type": "string", "description": "ISO 8601 date-time with offset" },
        "expiryDt": { "type": "string", "description": "ISO 8601 date-time with offset" },
        "maturityDt": { "type": "string", "description": "ISO 8601 date-time with offset" },
        "currency": { "type": "string" },
        "sourceSystem": { "type": "string" },
        "deletedInd": { "type": "boolean" }
      },
      "required": ["agreementId", "agreementNo", "agreementType"]
    },
    "balances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "balanceId": { "type": "string", "description": "UUID" },
          "agreementId": { "type": "string", "description": "UUID" },
          "balanceType": { "type": "string" },
          "creditAmnt": { "type": "number" },
          "debitAmnt": { "type": "number" },
          "balanceDate": { "type": "string", "description": "ISO 8601 date-time with offset" }
        },
        "required": ["balanceId", "agreementId"]
      }
    },
    "interestRates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "interestRateId": { "type": "string", "description": "UUID" },
          "agreementId": { "type": "string", "description": "UUID" },
          "interestRateType": { "type": "string" },
          "interestRate": { "type": "number" },
          "baseRate": { "type": ["number", "null"] },
          "spreadRate": { "type": ["number", "null"] },
          "effectiveDate": { "type": "string", "description": "ISO 8601 date-time with offset" }
        },
        "required": ["interestRateId", "agreementId"]
      }
    },
    "paymentSchedules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "paymentScheduleId": { "type": "string", "description": "UUID" },
          "agreementId": { "type": "string", "description": "UUID" },
          "paymentDate": { "type": "string", "description": "ISO 8601 date-time with offset" },
          "paymentAmnt": { "type": "number" },
          "businessDate": { "type": "string", "description": "ISO 8601 date-time with offset" }
        },
        "required": ["paymentScheduleId", "agreementId"]
      }
    },
    "party": {
      "type": "object",
      "properties": {
        "partyId": { "type": "string", "description": "UUID" },
        "agreementId": { "type": "string", "description": "UUID" },
        "unbnkId": { "type": "string" },
        "memberIdNo": { "type": "string" }
      },
      "required": ["partyId", "agreementId"]
    }
  },
  "required": ["agreementNo", "agreementType", "agreement"]
}
